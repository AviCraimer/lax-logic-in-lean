import LaxLogic.PLLSemUIFrag
import LaxLogic.PLLG4Term
import LaxLogic.PLLTerms

/-!
# Base layer for the certified RN(◯,{}) dictionary

Support for `wip/rnDict.lean` (which is GENERATED by
`wip/rnDictGen.lean` — do not edit that file by hand):

* `ofG4`: the kernel-checked bridge from a `G4cTm` proof term to
  `Deriv` (via `G4cTm.toTm` and Curry–Howard `Tm.toND`).  This is the
  pinning discipline: the searcher runs OFFLINE in the generator, and
  only the found proof terms — checked by the kernel on elaboration —
  enter the trusted development.
* The generic `Interd` laws (commutativity, idempotence, the ⊥/⊤ unit
  and absorption laws, ◯-idempotence), which discharge the trivial
  cells of the closure tables without emitted certificates.
-/

open PLLFormula

namespace PLLND
namespace SemUI
namespace RND

/-! ## The bridge: a G4iLL″ proof term certifies `Deriv` -/

/-- A `G4cTm` proof term yields natural-deduction derivability:
project to `Tm` (`G4cTm.toTm`) and cross Curry–Howard (`Tm.toND`). -/
theorem ofG4 {Γ : List PLLFormula} {C : PLLFormula} (t : G4cTm Γ C) :
    Deriv Γ C :=
  t.toTm.elim fun tm => ⟨tm.toND⟩

/-! ## `Deriv` wrappers for the two ◯ rules -/

theorem dSomehowIntro {Γ : List PLLFormula} {φ : PLLFormula} :
    Deriv Γ φ → Deriv Γ (.somehow φ)
  | ⟨p⟩ => ⟨.laxIntro p⟩

theorem dSomehowElim {Γ : List PLLFormula} {φ ψ : PLLFormula} :
    Deriv Γ (.somehow φ) → Deriv (φ :: Γ) (.somehow ψ) →
    Deriv Γ (.somehow ψ)
  | ⟨p⟩, ⟨q⟩ => ⟨.laxElim p q⟩

/-- `⊤` (= `⊥ ⊃ ⊥`) is derivable in any context. -/
theorem topD {Γ : List PLLFormula} : Deriv Γ truePLL :=
  Deriv.impIntro (Deriv.iden (.head _))

/-! ## Generic `Interd` laws -/

theorem and_comm_i (φ ψ : PLLFormula) : Interd (φ.and ψ) (ψ.and φ) :=
  ⟨Deriv.andIntro (Deriv.andElim2 (Deriv.iden (.head _)))
      (Deriv.andElim1 (Deriv.iden (.head _))),
   Deriv.andIntro (Deriv.andElim2 (Deriv.iden (.head _)))
      (Deriv.andElim1 (Deriv.iden (.head _)))⟩

theorem or_comm_i (φ ψ : PLLFormula) : Interd (φ.or ψ) (ψ.or φ) :=
  ⟨Deriv.orElim (Deriv.iden (.head _))
      (Deriv.orIntro2 (Deriv.iden (.head _)))
      (Deriv.orIntro1 (Deriv.iden (.head _))),
   Deriv.orElim (Deriv.iden (.head _))
      (Deriv.orIntro2 (Deriv.iden (.head _)))
      (Deriv.orIntro1 (Deriv.iden (.head _)))⟩

theorem and_idem_i (φ : PLLFormula) : Interd (φ.and φ) φ :=
  ⟨Deriv.andElim1 (Deriv.iden (.head _)),
   Deriv.andIntro (Deriv.iden (.head _)) (Deriv.iden (.head _))⟩

theorem or_idem_i (φ : PLLFormula) : Interd (φ.or φ) φ :=
  ⟨Deriv.orElim (Deriv.iden (.head _)) (Deriv.iden (.head _))
      (Deriv.iden (.head _)),
   Deriv.orIntro1 (Deriv.iden (.head _))⟩

theorem bot_and_i (φ : PLLFormula) : Interd (falsePLL.and φ) falsePLL :=
  ⟨Deriv.andElim1 (Deriv.iden (.head _)),
   Deriv.andIntro (Deriv.iden (.head _))
      (Deriv.falsoElim _ (Deriv.iden (.head _)))⟩

theorem top_and_i (φ : PLLFormula) : Interd (truePLL.and φ) φ :=
  ⟨Deriv.andElim2 (Deriv.iden (.head _)),
   Deriv.andIntro topD (Deriv.iden (.head _))⟩

theorem bot_or_i (φ : PLLFormula) : Interd (falsePLL.or φ) φ :=
  ⟨Deriv.orElim (Deriv.iden (.head _))
      (Deriv.falsoElim _ (Deriv.iden (.head _)))
      (Deriv.iden (.head _)),
   Deriv.orIntro2 (Deriv.iden (.head _))⟩

theorem top_or_i (φ : PLLFormula) : Interd (truePLL.or φ) truePLL :=
  ⟨topD, Deriv.orIntro1 (Deriv.iden (.head _))⟩

theorem bot_imp_i (φ : PLLFormula) : Interd (falsePLL.ifThen φ) truePLL :=
  ⟨topD, Deriv.impIntro (Deriv.falsoElim _ (Deriv.iden (.head _)))⟩

theorem top_imp_i (φ : PLLFormula) : Interd (truePLL.ifThen φ) φ :=
  ⟨Deriv.impElim (Deriv.iden (.head _)) topD,
   Deriv.impIntro (Deriv.iden (.tail _ (.head _)))⟩

theorem imp_top_i (φ : PLLFormula) : Interd (φ.ifThen truePLL) truePLL :=
  ⟨topD, Deriv.impIntro topD⟩

theorem imp_self_i (φ : PLLFormula) : Interd (φ.ifThen φ) truePLL :=
  ⟨topD, Deriv.impIntro (Deriv.iden (.head _))⟩

theorem box_idem_i (φ : PLLFormula) :
    Interd (φ.somehow.somehow) φ.somehow :=
  ⟨dSomehowElim (Deriv.iden (.head _)) (Deriv.iden (.head _)),
   dSomehowIntro (Deriv.iden (.head _))⟩

end RND
end SemUI
end PLLND
