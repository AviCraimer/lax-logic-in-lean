			     val yypos = i0+ !yygone
			open UserDeclarations Internal.StartStates
 in (yybufpos := i; case yyk of 

			(* Application actions *)

  11 => (YYBEGIN MAIN; lex_state := Lex_main; FUN(!line,!line))
| 14 => (lex())
| 16 => (next_line(); lex())
| 18 => (lex_state := Lex_initial; print"Comment...";
			YYBEGIN COMMENT; lex())
| 2 => let val yytext=yymktext() in CAP(String.str(hd(explode yytext)),!line,!line) end
| 20 => let val yytext=yymktext() in error ("ignoring illegal character" ^ yytext,
			   !line,!line); lex() end
| 22 => (COLON(!line,!line))
| 24 => (next_line(); NEWLINE(!line,!line))
| 26 => (SEMICOLON(!line,!line))
| 29 => let val yytext=yymktext() in NUMBER
			  (List.foldr (fn (a,r) => ord(a)-ord(#"0")+10*r) 0
				      (rev(explode yytext)),
			   !line,!line) end
| 38 => let val yytext=yymktext() in case find yytext of SOME v => v(!line,!line)
		        | NONE => VAR(yytext,!line,!line) end
| 41 => (YYBEGIN CHOICE; lex_state := Lex_choice; STAR(!line,!line))
| 43 => (COMMA(!line,!line))
| 45 => (LRBR(!line,!line))
| 47 => (RRBR(!line,!line))
